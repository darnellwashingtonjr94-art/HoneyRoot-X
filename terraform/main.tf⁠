provider "aws" {
  region = "us-east-1"
}

resource "aws_instance" "honeyroot" {
  ami           = "ami-0c7217cdde317cfec" # Ubuntu 22.04 LTS
  instance_type = "t2.micro"
  key_name      = var.ssh_key_name
  vpc_security_group_ids = [aws_security_group.honeyroot_sg.id]

  user_data = file("cloud-init.yaml")

  tags = {
    Name = "HoneyRoot-X-Node"
  }
}

resource "aws_security_group" "honeyroot_sg" {
  name        = "honeyroot_sg"
  description = "Allow inbound SSH traffic to honeypot"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
